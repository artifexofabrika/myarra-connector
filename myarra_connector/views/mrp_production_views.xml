<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_production_list_inherit_myarra" model="ir.ui.view">
        <field name="name">mrp.production.list.inherit.myarra</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <header>
                    <button name="action_sync_to_myarra"
                            string="Sync to Myarra"
                            type="object"
                            display="always"
                            class="btn-primary"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_myarra" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.myarra</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Myarra" name="myarra" groups="base.group_system">
                    <block title="Myarra Connector">
                        <setting id="myarra_api_url_setting" string="Myarra API URL" help="Local IP and port of the Myarra appliance.">
                            <field name="myarra_api_url"/>
                        </setting>
                        <setting id="myarra_api_token_setting" string="Myarra API Token" help="Shared secret required by the Myarra appliance.">
                            <field name="myarra_api_token" password="True"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>